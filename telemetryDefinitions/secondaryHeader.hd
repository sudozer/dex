{
    "fields": [
        {
            "fieldName": "time_bytes",
            "type": "uint",
            "bitLength": 40,
            "description": "Packet creation time (seconds since midnight January 5-6 1980); see ISS SSP 41175-02 for format specification.",
            "bitstructType": "u40",
            "defaultValue": 0,
            "autofill":"issTime"
        },
        {
            "fieldName": "dataControl_timeId",
            "type": "uint",
            "bitLength": 2,
            "description": "Secondary header data control fields, per ISS SSP 52050.",
            "defaultValue": 0,
            "bitstructType":"u2"
        },
        {
            "fieldName": "dataControl_checkWord",
            "type": "uint",
            "bitLength": 1,
            "description": "Secondary header data control fields, per ISS SSP 52050.",
            "defaultValue": 0,
            "bitstructType": "u1"
        },
        {
            "fieldName": "dataControl_spare",
            "type": "uint",
            "bitLength": 1,
            "description": "Secondary header data control fields, per ISS SSP 52050.",
            "defaultValue": 0,
            "bitstructType":"u1"
        },
        {
            "fieldName": "dataControl_packetType",
            "type": "uint",
            "bitLength": 4,
            "description": "Secondary header data control fields, per ISS SSP 52050.",
            "defaultValue": 0,
            "bitstructType": "u4"
        },
        {
            "fieldName": "secHeaderId",
            "type": "uint32_t",
            "bitLength": 32,
            "description": "The ISS secondary header ID; used only for fill here.",
            "bitstructType": "u32",
            "defaultValue": 0
        },
        {
            "fieldName": "packetId",
            "type": "uint16_t",
            "bitLength": 16,
            "description": "The program specific ID used by the controller electronics to discriminate packets.",
            "bitstructType": "u16",
            "defaultValue": 2000
        }
    ],
    "totalBitLength": 96
