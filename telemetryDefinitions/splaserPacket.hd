            "bitstructType": "u8"
        },
        {
            "fieldName": "vehicle_sw_update_hash",
            "bitLength": 64,
            "type": "uint64_t",
            "description": "The first 64 bits of the sha256 hash of the software update file fetched, in a big-endian format. Initially 0 before a software update fetch has completed",
