            "bitstructType": "u32"
        },
        {
            "fieldName": "vehicle_sw_update_enabled",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "1 if software update via Space Vehicle is enabled. 0 otherwise.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
