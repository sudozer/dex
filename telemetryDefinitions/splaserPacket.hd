        },
        {
            "fieldName": "config_counter",
            "bitLength": 64,
            "type": "uint64_t",
            "description": "This field's recommended use is to detect stale packets.",
            "units": "Count",
            "bitstructType": "u64"
        },
        {
            "fieldName": "config_0",
            "bitLength": 32,
            "type": "uint32_t",
            "description": "",
            "units": "",
            "bitstructType": "u32"
        },
        {
            "fieldName": "cmd_pkt_rx",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "1 if the Plaser Unit has received a Command Packet from the Space Vehicle in the last 100 ms. 0 otherwise. This rolls up the following four fields.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "No",
                    "1": "Yes"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "cmd_pkt_rx_via_if1",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "1 if the Plaser Unit has received a Command Packet from the Space Vehicle over the Control Interface of Plaser Unit 1 in the last 100 ms. 0 otherwise.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "No",
                    "1": "Yes"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "cmd_pkt_rx_via_if2",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "1 if the Plaser Unit has received a Command Packet from the Space Vehicle over the Control Interface of Plaser Unit 2 in the last 100 ms. 0 otherwise.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "No",
                    "1": "Yes"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "cmd_pkt_rx_via_if3",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "1 if the Plaser Unit has received a Command Packet from the Space Vehicle over the Control Interface of Plaser Unit 3 in the last 100 ms. 0 otherwise.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "No",
                    "1": "Yes"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "cmd_pkt_rx_via_if4",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "1 if the Plaser Unit has received a Command Packet from the Space Vehicle over the Control Interface of Plaser Unit 4 in the last 100 ms. 0 otherwise.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "No",
                    "1": "Yes"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "ctrl_enet_last_pkt_drop_status",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "Enum indicating the reason a control packet was dropped after being received at the Plaser Unit.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "NoDrop",
                    "1": "BadMessage",
                    "2": "StaleMessage",
                    "3": "BadCRC",
                    "4": "BadFrame",
                    "5": "BadElement"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "reboot_pending",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "1 if the Plaser Unit will reboot itself shortly. 0 otherwise.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "No",
                    "1": "Yes"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "reboot_reason",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "Enum indicating reason for pending re-boot (if any).",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "NoReboot",
                    "1": "SoftwareUpdate",
                    "2": "OverTemperature"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "plaser_unit_uptime",
            "bitLength": 64,
            "type": "uint64_t",
            "description": "Time this Plaser Unit has been booted since the last reboot, in nano seconds.",
            "units": "ns",
            "bitstructType": "u64",
            "conversion": {
                "conversionFunction": "Convert ns to day/hour/minute/second string",
                "conversionArgs": {},
                "convertedType": "char"
            }
        },
        {
            "fieldName": "plaser_unit_state",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "Enum indicating high level Plaser Unit state - more future states TBR.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "LowPower",
                    "1": "Idle",
                    "2": "Active"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "laser_terminal_state",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "Enum indicating Laser Terminal state - TBR.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "Idle",
                    "1": "Active",
                    "2": "Faulted"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "star_tracker_state",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "Enum indicating star tracker state - TBR.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "Off",
                    "1": "Active",
                    "2": "Faulted"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "gnss_state",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "Enum indicating GNSS state - TBR.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "Off",
                    "1": "Active",
                    "2": "Faulted"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "tlm_dl_requested",
            "bitLength": 16,
            "type": "uint16_t",
            "description": "This counter increments each time the Plaser Unit requests a telemetry downlink",
            "units": "Request Count",
            "bitstructType": "u16"
        },
        {
            "fieldName": "num_nw_pkt_rx",
            "bitLength": 16,
            "type": "uint16_t",
            "description": "Number of Network Entry Packets received by the Plaser Unit from the Space Vehicle. This counter rolls over to 0 from maximum value.",
            "units": "Packet Count",
            "bitstructType": "u16"
        },
        {
            "fieldName": "num_nw_pkt_valid",
            "bitLength": 16,
            "type": "uint16_t",
            "description": "Number of received Network Entry Packets that were successfullly parsed by the Plaser Unit. This counter rolls over to 0 from maximum value.",
            "units": "Packet Count",
            "bitstructType": "u16"
        },
        {
            "fieldName": "nw_entry_pkt_hash",
            "bitLength": 32,
            "type": "uint32_t",
            "description": "The first 32 bits of the sha256 hash of the software update file fetched, in big-endian format. Initially 0 before a network packet entry packet is received.",
            "units": "Hash",
            "bitstructType": "u32",
            "conversion": {
                "conversionFunction": "hex",
                "conversionArgs": {},
                "convertedType": "char"
            }
        },
        {
            "fieldName": "next_nw_expected_timestamp",
            "bitLength": 64,
            "type": "uint64_t",
            "description": "GPS time in nanoseconds. Indicates the next expected timestamp at which the Plaser Unit has a network path to ground (see Network operational), or the current time if the Plaser Unit currently expects network connectivity. This timestamp is a prediction and is limited by SpaceX internal look-ahead duration.",
            "units": "gps_ns",
            "bitstructType": "u64",
            "conversion": {
                "conversionFunction": "Convert GPS time to YYYY-MM-DD HH:MM:SS.s format",
                "conversionArgs": {},
                "convertedType": "char"
            }
        },
        {
            "fieldName": "next_nw_expected_duration",
            "bitLength": 32,
            "type": "float",
            "description": "Expected duration for the next contiguous period of Plaser Unit network connectivity to ground (see Next Network Operational Expected Timestamp), or expected remaining duration if the Plaser Unit currently expects network connectivity. This duration is a prediction and is limited by SpaceX internal look-ahead duration.",
            "units": "s",
            "bitstructType": "f32"
        },
        {
            "fieldName": "target_ephemeris_staleness",
            "bitLength": 32,
            "type": "float",
            "description": "Indicates how stale (in seconds) the ephemerides are for the currently active Laser Terminal target. This is the difference between the current time and the ephemeris timestamp of the satellite which the terminal is currently targeting, or -1 if the terminal has no target assigned.",
            "units": "s",
            "bitstructType": "f32"
        },
        {
            "fieldName": "plaser_unit_gnc_valid",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "1 if navigation information coming from the Plaser Unit should be trusted and used by the Laser Terminal. 0 otherwise",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "No",
                    "1": "Yes"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "vehicle_attitude_valid",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "Plaser will indicate here whether its received attitude is valid or not.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "No",
                    "1": "Yes"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "vehicle_ephemeris_valid",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "Plaser will indicate here whether its received ephemeris is valid or not.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
                "conversionArgs": {
                    "0": "No",
                    "1": "Yes"
                },
                "convertedType": "char"
            }
        },
        {
            "fieldName": "vehicle_sw_update_fetch_enabled",
            "bitLength": 8,
            "type": "uint8_t",
            "description": "1 if software update fetch from Space Vehicle is enabled. 0 otherwise.",
            "units": "Enum",
            "bitstructType": "u8",
            "conversion": {
                "conversionFunction": "lookupTable",
