            {"fieldName": "missionTime", "type": "uint64_t", "description": "Mission time", "units": "ticks", "bitLength": 64, "bitstructType": "u64"},
            {"fieldName": "accelX", "type": "int8_t", "description": "X acceleration", "units": "counts", "bitLength": 8, "bitstructType": "s8"},
            {"fieldName": "accelY", "type": "int32_t", "description": "Y acceleration", "units": "counts", "bitLength": 32, "bitstructType": "s32"},
            {"fieldName": "pressure", "type": "float", "description": "Pressure", "units": "kPa", "bitLength": 32, "bitstructType": "f32"},
            {"fieldName": "position", "type": "double", "description": "Position", "units": "km", "bitLength": 64, "bitstructType": "f64"},
            {"fieldName": "sourceTag", "type": "char", "description": "Source tag", "units": "ASCII", "bitLength": 8, "bitstructType": "t8"},
            {"fieldName": "flags", "type": "uint", "description": "Status flags", "units": "bits", "bitLength": 10, "bitstructType": "u10"}
        ]
